---
layout: null
---
<?xml version="1.0" encoding="UTF-8"?>
<rss version="2.0">
<channel>
  <title>{{ site.title | xml_escape }}</title>
  <link>{{ "/" | absolute_url }}</link>
  <atom:link href="{{ "/feed.xml" | absolute_url }}" rel="self" type="application/rss+xml" xmlns:atom="http://www.w3.org/2005/Atom" />
  <description>{{ site.description | xml_escape }}</description>
  <language>lt</language>
{% assign naujienos = site.news | sort: 'date' | reverse %}
{% for item in naujienos limit:20 %}
  <item>
    <title>{{ item.title | xml_escape }}</title>
    <link>{{ item.url | absolute_url }}</link>
    <guid isPermaLink="true">{{ item.url | absolute_url }}</guid>
    <pubDate>{{ item.date | date_to_rfc822 }}</pubDate>
    <description>{{ item.content | strip_html | xml_escape }}</description>
  </item>
{% endfor %}
</channel>
</rss>
